  "keyFeatures": [
    "Multi-step event creation wizard (basic info, schedule, location, cover image, tickets, review)",
    "Multiple ticket types per event with configurable pricing, visibility, and quantity limits",
    "PIX-based checkout via AbacatePay with hosted payment page",
    "PIX installment payments (up to 12 installments) for eligible tickets",
    "Automatic payment reconciliation for pending checkouts",
    "Organizer dashboard with KPIs: revenue, tickets sold, upcoming events, participants",
    "Financial reporting with date filters, per-event breakdowns, and CSV export",
    "Payout (repasse) management with PIX key validation and platform-controlled disbursements",
    "Participant management with check-in tracking and full-text search",
    "Public event storefront with category filtering and pagination",
    "Webhook support for checkout, PIX transparent payments, payouts, and transfers",
    "Email notifications for registration confirmation",
    "Rate-limited authentication with email confirmation flow",
    "Role-based access: attendee, organizer, admin, super_admin",
    "Configurable platform fee percentage and convenience fee calculation method"
  ],
